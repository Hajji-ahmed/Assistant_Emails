# This file is used ONLY for the first-run bootstrap.
# After the first launch, config.json becomes the source of truth
# and should be edited via the /config page in the web UI.
#
# Copy to .env and fill in your values if you want to bootstrap from the CLI.

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
TEMPERATURE=0.2
MAX_OUTPUT_TOKENS=500

# Gmail SMTP (app password, not your real Gmail password)
# https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
